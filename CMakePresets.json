{
  "version": 3,
  "configurePresets": [
    {
      "name": "ucrt64",
      "displayName": "MSYS2 UCRT64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ucrt64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ucrt64-release",
      "inherits": "ucrt64",
      "displayName": "MSYS2 UCRT64 Release",
      "binaryDir": "${sourceDir}/build/ucrt64-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "ucrt64", "configurePreset": "ucrt64" },
    { "name": "ucrt64-release", "configurePreset": "ucrt64-release" }
  ],
  "testPresets": [
    { "name": "ucrt64", "configurePreset": "ucrt64", "output": { "outputOnFailure": true } }
  ]
}
